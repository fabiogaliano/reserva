{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "vitest/globals"],
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Workspace packages import the published entrypoints, exactly as an external adapter author
    // does; in this repo those specifiers resolve to the sources rather than to a built dist/.
    "paths": {
      "@reservajs/astro": ["./src/index.ts"],
      "@reservajs/astro/core": ["./src/core/index.ts"],
      "@reservajs/astro/runtime": ["./src/runtime.ts"],
      "@reservajs/astro/email": ["./src/email/index.ts"],
      "@reservajs/stripe": ["./packages/stripe/src/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts", "packages", "vitest.config.ts", "vitest.workers.config.ts", "vitest.component.config.ts"],
  // tests/pack-fixture is a standalone consumer project (its own tsconfig.json, typechecked by
  // scripts/pack-test.ts against the packed tarball) whose files import the bare `@reservajs/astro`
  // specifier on purpose, exercising package self-resolution the way a real install would rather
  // than this repo's own source — that would not resolve under the root project's tsconfig.
  "exclude": ["tests/pack-fixture"]
}
