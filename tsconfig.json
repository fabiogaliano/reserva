{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "vitest/globals"],
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // These specifiers resolve to source, not a built dist/, so workspace code typechecks
    // against the same published entrypoints an external consumer would import.
    "paths": {
      "@reservajs/astro": ["./src/index.ts"],
      "@reservajs/astro/core": ["./src/core/index.ts"],
      "@reservajs/astro/runtime": ["./src/runtime.ts"],
      "@reservajs/astro/email": ["./src/email/index.ts"],
      "@reservajs/stripe": ["./packages/stripe/src/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts", "packages", "vitest.config.ts", "vitest.workers.config.ts", "vitest.component.config.ts"],
  // tests/pack-fixture is a standalone consumer project that imports the bare `@reservajs/astro`
  // specifier, to exercise real package resolution — that doesn't resolve under this repo's own
  // tsconfig.
  "exclude": ["tests/pack-fixture"]
}
