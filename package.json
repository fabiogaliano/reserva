{
  "name": "@reservajs/astro",
  "version": "0.2.0",
  "description": "The edge-native booking engine for fixed-capacity time slots — self-hosted on Cloudflare Workers + D1, no per-booking fees.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiogaliano/reserva.git"
  },
  "author": "Fábio Galiano",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "migrations",
    "scripts/reserva-migrate.ts",
    "examples/smoke-site/worker",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "bin": {
    "reserva-migrate": "./scripts/reserva-migrate.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./providers/calendar-google": {
      "types": "./dist/providers/calendar-google/index.d.ts",
      "default": "./dist/providers/calendar-google/index.js"
    },
    "./providers/email-brevo": {
      "types": "./dist/providers/email-brevo/index.d.ts",
      "default": "./dist/providers/email-brevo/index.js"
    },
    "./providers/email-none": {
      "types": "./dist/providers/email-none/index.d.ts",
      "default": "./dist/providers/email-none/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./ui": {
      "types": "./dist/ui/messages.d.ts",
      "default": "./dist/ui/messages.js"
    },
    "./components/ManageBooking.astro": "./dist/components/ManageBooking.astro",
    "./components/AdminDashboard.astro": "./dist/components/AdminDashboard.astro"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "vitest run && vitest run --config vitest.component.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:pack": "bun scripts/pack-test.ts",
    "test:preview": "bun scripts/smoke-preview-test.ts",
    "test:scheduled": "bun scripts/smoke-scheduled-test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "docs:contract": "bun scripts/contract-docs.ts",
    "docs:contract:check": "bun scripts/contract-docs.ts --check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "verify": "bun run typecheck && bun run docs:contract:check && bun run test && bun run test:workers && bun run test:scheduled && bun run test:pack",
    "check": "bun run audit && bun run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@reservajs/astro": "file:.",
    "sharp": "^0.35.0",
    "undici": "^7.29.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.1"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14.0.0 <15.0.0",
    "astro": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "cally": "^0.9.2",
    "date-fns": "^4.4.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@changesets/cli": "^3.0.1",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "astro": "^7.2.2",
    "standardwebhooks": "^1.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
