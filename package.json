{
  "name": "bookkit",
  "version": "0.1.0",
  "description": "Reusable Astro booking integration for Cloudflare Workers, D1, and Stripe",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "migrations",
    "examples/astro.config.ts",
    "examples/client-config.ts",
    "examples/runtime.ts",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./core": "./src/core/index.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/calendar-google": "./src/providers/calendar-google/index.ts",
    "./providers/payments-stripe": "./src/providers/payments-stripe/index.ts",
    "./providers/email-brevo": "./src/providers/email-brevo/index.ts",
    "./providers/email-none": "./src/providers/email-none/index.ts",
    "./providers/ops-tourflow": "./src/providers/ops-tourflow/index.ts",
    "./runtime": "./src/runtime.ts",
    "./components/BookingWidget.astro": "./src/components/BookingWidget.astro",
    "./components/ManageBooking.astro": "./src/components/ManageBooking.astro",
    "./components/AdminDashboard.astro": "./src/components/AdminDashboard.astro"
  },
  "scripts": {
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run test:workers"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14.0.0",
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260721.1",
    "astro": "^7.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
