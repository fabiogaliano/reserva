{
  "name": "bookkit",
  "version": "0.1.0",
  "description": "Reusable Astro booking integration for Cloudflare Workers, D1, and Stripe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiogaliano/bookkit.git"
  },
  "author": "Fábio Galiano",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "migrations",
    "scripts/bookkit-migrate.ts",
    "examples/astro.config.ts",
    "examples/client-config.ts",
    "examples/runtime.ts",
    "examples/smoke-site/astro.config.ts",
    "examples/smoke-site/package.json",
    "examples/smoke-site/README.md",
    "examples/smoke-site/wrangler.jsonc",
    "examples/smoke-site/src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "bookkit-migrate": "./scripts/bookkit-migrate.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/calendar-google": "./src/providers/calendar-google/index.ts",
    "./providers/payments-stripe": "./src/providers/payments-stripe/index.ts",
    "./providers/email-brevo": "./src/providers/email-brevo/index.ts",
    "./providers/email-none": "./src/providers/email-none/index.ts",
    "./providers/ops-tourflow": "./src/providers/ops-tourflow/index.ts",
    "./runtime": "./src/runtime.ts",
    "./components/BookingWidget.astro": "./src/components/BookingWidget.astro",
    "./components/ManageBooking.astro": "./src/components/ManageBooking.astro",
    "./components/AdminDashboard.astro": "./src/components/AdminDashboard.astro"
  },
  "scripts": {
    "test": "vitest run && vitest run --config vitest.component.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:pack": "bun scripts/pack-test.ts",
    "test:preview": "bun scripts/smoke-preview-test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "verify": "bun run typecheck && bun run test && bun run test:workers",
    "check": "bun run audit && bun run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14.0.0 <15.0.0",
    "astro": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "cally": "^0.9.2",
    "date-fns": "^4.4.0",
    "smol-toml": "^1.8.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@playwright/test": "^1.62.1",
    "astro": "^7.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
