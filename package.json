{
  "name": "@reservajs/astro",
  "version": "0.5.1",
  "description": "A booking engine for fixed-capacity time slots, built as an Astro integration — runs in your own Cloudflare account on Workers + D1, no per-booking fees.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiogaliano/reserva.git"
  },
  "author": "Fábio Galiano",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "migrations",
    "README.md",
    "AGENTS.md",
    "docs/api.md",
    "docs/configuration.md",
    "docs/customization.md",
    "docs/deployment.md",
    "docs/development.md",
    "docs/providers.md",
    "docs/MIGRATING-v2.md",
    "LICENSE"
  ],
  "bin": {
    "reserva-migrate": "dist/reserva-migrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./providers/calendar-google": {
      "types": "./dist/providers/calendar-google/index.d.ts",
      "default": "./dist/providers/calendar-google/index.js"
    },
    "./providers/email-brevo": {
      "types": "./dist/providers/email-brevo/index.d.ts",
      "default": "./dist/providers/email-brevo/index.js"
    },
    "./providers/email-none": {
      "types": "./dist/providers/email-none/index.d.ts",
      "default": "./dist/providers/email-none/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./components/ManageBooking.astro": "./dist/components/ManageBooking.astro"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "vitest run --project unit --project component",
    "test:workers": "vitest run --project workers",
    "test:pack": "bun scripts/pack-test.ts",
    "test:quickstart": "bun scripts/quickstart-test.ts",
    "test:preview": "bun scripts/smoke-preview-test.ts",
    "test:scheduled": "bun scripts/smoke-scheduled-test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit --project component",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "docs:contract": "bun scripts/contract-docs.ts",
    "docs:contract:check": "bun scripts/contract-docs.ts --check",
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "changeset": "changeset",
    "release:version": "changeset version && bun install --lockfile-only",
    "release:publish": "changeset publish",
    "verify": "bun run generate:check && bun run typecheck && bun run docs:contract:check && bun run test && bun run test:workers",
    "verify:packaged": "bun run test:preview && bun run test:scheduled && bun run test:pack && bun run test:quickstart",
    "check": "bun run audit && bun run verify && bun run verify:packaged"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@reservajs/astro": "file:.",
    "sharp": "^0.35.0",
    "undici": "^7.29.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.1"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14.0.0 <15.0.0",
    "astro": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "cally": "^0.9.2",
    "date-fns": "^4.4.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "astro": "^7.3.2",
    "standardwebhooks": "^1.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
