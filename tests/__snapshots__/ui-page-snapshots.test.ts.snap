// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`confirmation page snapshots (no customization) > cancelled 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Booking cancelled — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="cancelled"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><h1>Booking cancelled</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">This booking was cancelled and is no longer active.</p><div class="bk-actions"><a class="bk-btn" href="https://example.test">Start a new booking</a></div></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > confirmed, full booking 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Booking confirmed — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="confirmed"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><span class="bk-badge bk-badge--ok">Confirmed</span><h1>Booking confirmed</h1><p class="bk-lead">Thank you — your booking is confirmed. A confirmation email is on its way.</p></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-ticket"><div class="bk-ticket-top"><div class="bk-ticket-date" aria-hidden="true"><span class="bk-ticket-month">Jun</span><span class="bk-ticket-day">15</span><span class="bk-ticket-time">09:00</span></div><div class="bk-ticket-body"><dl class="bk-facts"><dt>Service</dt><dd>Vintage Tour</dd><dt>Date</dt><dd>Mon, 15 June 2026 at 09:00 – 10:00</dd><dt>People</dt><dd>2 people</dd><dt>Total price</dt><dd>€100.00</dd><dt>Meeting point</dt><dd>Praça do Comércio <a href="https://maps.google.com/?q=Praca+do+Comercio" rel="noopener" target="_blank">Open in Google Maps</a></dd></dl></div></div><div class="bk-ticket-foot"><div class="bk-ticket-ref"><span>Reference</span><span class="bk-mono">LVT-2026-001</span></div><div class="bk-actions"><span class="bk-sub">Add to calendar</span><a class="bk-btn bk-btn--secondary bk-btn--sm" href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Example+City+Tours+%E2%80%94+Vintage+Tour&amp;dates=20260615T080000Z%2F20260615T090000Z&amp;location=Pra%C3%A7a+do+Com%C3%A9rcio&amp;details=Reference%3A+LVT-2026-001" rel="noopener" target="_blank">Google Calendar</a><a class="bk-btn bk-btn--secondary bk-btn--sm" href="data:text/calendar;charset=utf-8,BEGIN%3AVCALENDAR%0D%0AVERSION%3A2.0%0D%0APRODID%3A-%2F%2Freserva%2F%2FEN%0D%0ABEGIN%3AVEVENT%0D%0AUID%3A20260615T080000Z-reserva%0D%0ADTSTAMP%3A20260615T080000Z%0D%0ADTSTART%3A20260615T080000Z%0D%0ADTEND%3A20260615T090000Z%0D%0ASUMMARY%3AExample%20City%20Tours%20%E2%80%94%20Vintage%20Tour%0D%0ALOCATION%3APra%C3%A7a%20do%20Com%C3%A9rcio%0D%0ADESCRIPTION%3AReference%3A%20LVT-2026-001%0D%0AEND%3AVEVENT%0D%0AEND%3AVCALENDAR" download="booking.ics">Apple / Outlook (.ics)</a></div></div></section><section class="bk-card bk-whatsnext"><h2>What&#39;s next</h2><p>Save your reference and arrive a few minutes early. If you chose a custom pickup, we will contact you to confirm the address.</p></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > confirmed, summary 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Booking confirmed — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="confirmed"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><span class="bk-badge bk-badge--ok">Confirmed</span><h1>Booking confirmed</h1><p class="bk-lead">Thank you — your booking is confirmed. A confirmation email is on its way.</p></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-summary"><dl class="bk-facts"><dt>Service</dt><dd>Vintage Tour</dd><dt>Date</dt><dd>Mon, 15 June 2026 at 09:00</dd><dt>Reference</dt><dd>LVT-2026-001</dd></dl></section><section class="bk-card bk-message"><p class="bk-lead">Your booking is confirmed. Full details and a link to manage your booking were emailed to you.</p></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > expired 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Checkout expired — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="expired"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><h1>Checkout expired</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">No confirmed payment was found for this session. Your card was not charged — you can start a new booking.</p><div class="bk-actions"><a class="bk-btn" href="https://example.test">Start a new booking</a></div></section><section class="bk-card bk-contact"><h2>Need help?</h2><p class="bk-sub"><a href="mailto:owner@example.test">owner@example.test</a> · <a href="tel:+351000000000">+351000000000</a></p></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > failed 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>We couldn&#39;t take this payment — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="failed"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><h1>We couldn&#39;t take this payment</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">We couldn&#39;t confirm your payment and no booking was made. Any voucher or bank instructions you received are void; if a payment does go through it will be refunded. Contact us and we&#39;ll sort it out.</p></section><section class="bk-card bk-contact"><h2>Need help?</h2><p class="bk-sub"><a href="mailto:owner@example.test">owner@example.test</a> · <a href="tel:+351000000000">+351000000000</a></p></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > not found 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Booking not found — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="not_found"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><h1>Booking not found</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">We could not find a booking for this link. Check the link from your email, or start a new booking.</p><div class="bk-actions"><a class="bk-btn" href="https://example.test">Start a new booking</a></div></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > pending 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><meta http-equiv="refresh" content="3;url=https://example.test/booking-confirmation?sessionId=cs_1&amp;attempt=1"><title>Confirming your payment… — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="pending"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><span class="bk-badge bk-badge--warn">Awaiting payment</span><h1>Confirming your payment…</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><div class="bk-spinner" aria-hidden="true"></div><p class="bk-lead">This page updates automatically. It usually takes a few seconds.</p></section></main></body></html>"`;

exports[`confirmation page snapshots (no customization) > pending, timed out 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Still waiting for the payment provider — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=1v2gvbm"></head><body class="bk-page bk-page--confirmation" data-bk-status="pending"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><span class="bk-badge bk-badge--warn">Awaiting payment</span><h1>Still waiting for the payment provider</h1></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">We&#39;re still waiting for the payment provider. You&#39;ll get an email once it&#39;s confirmed.</p><div class="bk-actions"><a class="bk-btn bk-btn--secondary" href="https://example.test/booking-confirmation?sessionId=cs_1&amp;attempt=0">Check again</a></div></section><section class="bk-card bk-contact"><h2>Need help?</h2><p class="bk-sub"><a href="mailto:owner@example.test">owner@example.test</a> · <a href="tel:+351000000000">+351000000000</a></p></section></main></body></html>"`;

exports[`manage page snapshots (no customization) > confirmed booking with actions 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Manage booking LVT-2026-001 — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=test"></head><body class="bk-page bk-page--manage" data-bk-status="confirmed"><header class="bk-masthead"><div class="bk-masthead-inner bk-masthead-inner--mid"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand"><a href="https://example.test">Example City Tours</a></p><h1>Manage booking <strong>LVT-2026-001</strong></h1><p class="bk-lead"><span class="bk-badge bk-badge--ok">Confirmed</span></p></div></header><main id="bk-main" class="bk-main bk-main--mid bk-main--raised"><div class="bk-cols"><section class="bk-card bk-summary bk-col-side" aria-label="Your booking"><h2>Your booking</h2><dl class="bk-facts"><dt>Service</dt><dd>Vintage Tour</dd><dt>Date</dt><dd>Mon, 15 June 2026 at 09:00 – 10:00</dd><dt>People</dt><dd>2 people</dd><dt>Total price</dt><dd>€100.00</dd><dt>Meeting point</dt><dd>Praça do Comércio <a href="https://maps.google.com/?q=Praca+do+Comercio" rel="noopener" target="_blank">Open in Google Maps</a></dd></dl><div class="bk-actions"><span class="bk-sub">Add to calendar</span><a class="bk-btn bk-btn--secondary bk-btn--sm" href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Example+City+Tours+%E2%80%94+Vintage+Tour&amp;dates=20260615T080000Z%2F20260615T090000Z&amp;location=Pra%C3%A7a+do+Com%C3%A9rcio&amp;details=Reference%3A+LVT-2026-001" rel="noopener" target="_blank">Google Calendar</a><a class="bk-btn bk-btn--secondary bk-btn--sm" href="data:text/calendar;charset=utf-8,BEGIN%3AVCALENDAR%0D%0AVERSION%3A2.0%0D%0APRODID%3A-%2F%2Freserva%2F%2FEN%0D%0ABEGIN%3AVEVENT%0D%0AUID%3A20260615T080000Z-reserva%0D%0ADTSTAMP%3A20260615T080000Z%0D%0ADTSTART%3A20260615T080000Z%0D%0ADTEND%3A20260615T090000Z%0D%0ASUMMARY%3AExample%20City%20Tours%20%E2%80%94%20Vintage%20Tour%0D%0ALOCATION%3APra%C3%A7a%20do%20Com%C3%A9rcio%0D%0ADESCRIPTION%3AReference%3A%20LVT-2026-001%0D%0AEND%3AVEVENT%0D%0AEND%3AVCALENDAR" download="booking.ics">Apple / Outlook (.ics)</a></div></section><div class="bk-col-main"><section class="bk-card bk-reschedule"><h2>Reschedule</h2><p class="bk-hint">Choose a new start time. Your price and party size stay the same.</p><form method="post" action="/booking/manage" data-reserva-reschedule><input type="hidden" name="action" value="reschedule"><input type="hidden" name="token" value="tok"><label class="bk-field" data-reserva-native-start><span>New start</span><input class="bk-input" name="start" type="datetime-local" required></label><button type="submit" class="bk-btn">Reschedule booking</button></form></section><section aria-label="Manage booking"><details class="bk-disclosure bk-card--danger bk-cancel"><summary>Cancel booking</summary><div><p>Cancelling frees your slot and cannot be undone.</p><p class="bk-hint">Free cancellation until Sun, 14 June 2026 at 10:00.</p><form method="post" action="/booking/manage"><input type="hidden" name="action" value="cancel"><input type="hidden" name="token" value="tok"><input type="hidden" name="refund" value="none"><button type="submit" class="bk-btn bk-btn--danger">Yes, cancel this booking</button></form></div></details></section></div></div></main></body></html>"`;

exports[`manage page snapshots (no customization) > invalid link 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Link not valid — Example City Tours</title><link rel="stylesheet" href="/booking/assets/reserva.css?v=test"></head><body class="bk-page bk-page--manage"><header class="bk-masthead"><div class="bk-masthead-inner"><button type="button" class="bk-theme-toggle" data-reserva-theme-toggle hidden data-mode="system" data-aria="Theme" data-l-system="System" data-l-light="Light" data-l-dark="Dark"></button><p class="bk-brand">Example City Tours</p><h1>Link not valid</h1><p class="bk-lead">This booking link is invalid or has expired. Use the exact link from your confirmation email, or contact us.</p></div></header><main id="bk-main" class="bk-main bk-main--raised"><section class="bk-card bk-message"><p class="bk-lead">Open your booking with the &quot;Manage my booking&quot; link in your confirmation email — it is the only way in. If you no longer have the email, contact us and we will resend it.</p></section><section class="bk-card bk-contact"><h2>Need help?</h2><p class="bk-sub"><a href="mailto:owner@example.test">owner@example.test</a> · <a href="tel:+351000000000">+351000000000</a></p></section></main></body></html>"`;
