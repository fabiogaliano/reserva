{
  // Publish build only; the repo's own tsconfig.json stays noEmit for typechecking.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    // The published tarball has no src/, so a map that merely points at one is unusable; inlining
    // the sources is what makes a consumer's stack trace resolve to real code.
    "inlineSources": true,
    "allowImportingTsExtensions": false,
    // Only the ambient types the emitted declarations need: test-runner globals aren't part of a
    // consumer's compile.
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"]
}
