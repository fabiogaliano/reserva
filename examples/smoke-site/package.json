{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "db:migrate": "bun ../../scripts/bookkit-migrate.ts --local",
    "demo": "bun run db:migrate && bun run dev",
    "e2e:server": "BOOKKIT_E2E_PERSIST=.wrangler-e2e bun e2e-dev-server.ts",
    "cron:dev": "wrangler dev --config worker/wrangler.jsonc --persist-to .wrangler/state --test-scheduled",
    "cron:trigger": "curl -s \"http://127.0.0.1:8787/__scheduled?cron=*+*+*+*+*\"",
    "cron:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  }
}
