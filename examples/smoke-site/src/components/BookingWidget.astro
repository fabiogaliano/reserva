---
import routeConfig from 'virtual:reserva/config';
// This example lives inside the Reserva repository, so it reads the library from source; a real
// consumer imports the same names from '@reservajs/astro/ui' and '@reservajs/astro/core'. The
// widget itself is example code — Reserva ships no customer booking funnel.
import { defaultLocale, formatMessage, resolveMessages, type ReservaMessages } from '../../../../src/ui/messages';
import './booking-widget.css';

interface StartOption {
  value: string;
  label: string;
}

interface Props {
  serviceSlug: string;
  checkoutEndpoint?: string;
  availabilityEndpoint?: string;
  // catalogEndpoint supplies pickup options/meeting points; quoteEndpoint is the same code path
  // checkout charges on, so an embed can never describe the service differently than the server does.
  catalogEndpoint?: string;
  quoteEndpoint?: string;
  availabilityFrom?: string;
  availabilityTo?: string;
  locale?: string;
  quantityOptions?: number[];
  startOptions?: StartOption[];
  // Shown in the <noscript> fallback as a way to book without JavaScript — pass
  // config.business.contact.email / .phone. Either, both, or neither may be supplied.
  contactEmail?: string;
  contactPhone?: string;
  // Partial overrides merged over the catalog selected by `locale`.
  messages?: Partial<ReservaMessages>;
  showTitle?: boolean;
}

const {
  serviceSlug,
  checkoutEndpoint = routeConfig.paths.checkout,
  availabilityEndpoint = routeConfig.paths.availability,
  catalogEndpoint = routeConfig.paths.catalog,
  quoteEndpoint = routeConfig.paths.quote,
  availabilityFrom,
  availabilityTo,
  locale = defaultLocale,
  quantityOptions = [1, 2, 3, 4],
  startOptions = [],
  contactEmail,
  contactPhone,
  messages: messageOverrides = {},
  showTitle = true,
} = Astro.props;

const t: ReservaMessages = { ...resolveMessages(undefined, locale), ...messageOverrides };
const usesAvailability = availabilityFrom !== undefined && availabilityTo !== undefined;
const quantityLabel = (n: number): string => formatMessage(n === 1 ? t['widget.person'] : t['widget.quantityCount'], { n });

// Everything the client script needs that can vary per render (copy, locale) travels in a JSON
// data island rather than an inline define:vars script, so no unhashed inline JS is ever emitted
// and strict script-src CSPs keep working.
const scriptData = {
  locale,
  i18n: {
    loadingSlots: t['widget.loadingSlots'],
    noSlots: t['widget.noSlots'],
    noDates: t['widget.noDates'],
    closed: t['widget.closed'],
    soldOut: t['widget.soldOut'],
    limited: t['widget.limited'],
    spotsLeft: t['widget.spotsLeft'],
    pickup: t['widget.pickup'],
    meetingPoint: t['widget.meetingPoint'],
    submit: t['widget.submit'],
    submitting: t['widget.submitting'],
    errorAvailability: t['widget.errorAvailability'],
    errorCheckout: t['widget.errorCheckout'],
  },
};

// A full UUID (not a truncated slice or a module-scope counter, which would collide across
// concurrent renders) so two instances of this component on the same page never share an id.
const dateLabelId = `bkw-date-label-${crypto.randomUUID()}`;
---

{/* Wraps this instance's form together with its fallback so the script (which may run once for
    several instances on one page — see below) can pair each form with its own fallback rather
    than a global lookup, and so one broken instance's fallback can never be confused for a
    sibling's. */}
<div class="bkw-instance" data-reserva-instance>
<form
  class="bk-widget"
  data-reserva-checkout
  data-endpoint={checkoutEndpoint}
  data-availability-endpoint={usesAvailability ? availabilityEndpoint : undefined}
  data-availability-from={availabilityFrom}
  data-availability-to={availabilityTo}
  data-catalog-endpoint={catalogEndpoint}
  data-quote-endpoint={quoteEndpoint}
  aria-label={t['widget.title']}
  hidden
>
  <script type="application/json" data-reserva-data set:html={JSON.stringify(scriptData).replace(/</g, '\\u003c')} />
  <input type="hidden" name="serviceSlug" value={serviceSlug} />
  <input type="hidden" name="locale" value={locale} />

  {showTitle && <h2 class="bkw-title">{t['widget.title']}</h2>}

  <label class="bkw-field">
    <span class="bkw-label">{t['widget.quantity']}</span>
    <select class="bkw-select" name="quantity" required>
      {quantityOptions.map((quantity) => <option value={quantity}>{quantityLabel(quantity)}</option>)}
    </select>
  </label>

  {usesAvailability ? (
    <>
      <div class="bkw-field">
        <span class="bkw-label" id={dateLabelId}>{t['widget.date']}</span>
        <calendar-date
          class="bkw-cal"
          min={availabilityFrom}
          max={availabilityTo}
          locale={locale}
          aria-labelledby={dateLabelId}
          data-reserva-calendar
        >
          <svg aria-hidden="true" slot="previous" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
          <svg aria-hidden="true" slot="next" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          <calendar-month></calendar-month>
        </calendar-date>
        <p class="bkw-cal-status" data-reserva-cal-status role="status">{t['widget.loadingSlots']}</p>
      </div>
      <fieldset class="bkw-field bkw-slots-field" data-reserva-slots-wrap hidden>
        <legend class="bkw-label">{t['widget.time']}</legend>
        <div class="bkw-slots" data-reserva-slots role="radiogroup" aria-label={t['widget.time']}></div>
      </fieldset>
    </>
  ) : startOptions.length > 0 ? (
    <label class="bkw-field">
      <span class="bkw-label">{t['widget.start']}</span>
      <select class="bkw-select" name="start" required>
        {startOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
  ) : (
    <label class="bkw-field">
      <span class="bkw-label">{t['widget.start']}</span>
      <input class="bkw-input" name="start" type="text" placeholder="2026-08-01T10:00:00+01:00" required />
    </label>
  )}

  {/* The service's location axes are filled in from the catalog by
      the script below (see renderLocation), the way slots are filled in from availability — a
      location-less service leaves both anchors empty, so the submitted FormData carries no
      pickupType/meetingPointId at all (checkout rejects the fields' mere presence for such a
      service). */}
  <div data-reserva-pickup-slot></div>
  <div data-reserva-meeting-point-slot></div>

  <p class="bkw-price" data-reserva-price aria-live="polite">
    <span class="bkw-price-label">{t['common.price']}</span>
    <strong class="bkw-price-value" data-reserva-price-value></strong>
    <span class="bkw-price-note">{t['widget.priceNote']}</span>
  </p>

  {/* In availability mode the button stays disabled until slots render, so a fast click can never
      post an empty start; its label shows the loading state until renderSlots restores the normal
      submit label and re-enables it. */}
  <button type="submit" class="bkw-submit" disabled={usesAvailability}>{usesAvailability ? t['widget.loadingSlots'] : t['widget.submit']}</button>
  <p class="bkw-error" data-reserva-error role="alert" hidden>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
    <span data-reserva-error-text></span>
  </p>
  <button type="button" class="bkw-retry" data-reserva-retry hidden>{t['widget.retry']}</button>
</form>

{/* Visible by default — not `hidden` — because a hidden fallback cannot help when the widget
    module's request is blocked or its synchronous init throws before the script below ever
    reaches the point where it hides this and reveals the form (see that script: only a fully
    successful init does so). A visitor briefly seeing this before a healthy widget finishes
    initializing is the intended progressive-enhancement baseline, not a bug. */}
<div class="bkw-fallback" data-reserva-fallback>
  <p>{t['widget.noscript']}</p>
  {(contactEmail || contactPhone) && (
    <p class="bkw-noscript-contact">
      {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
      {contactEmail && contactPhone && ' · '}
      {contactPhone && <a href={`tel:${contactPhone}`}>{contactPhone}</a>}
    </p>
  )}
</div>

{/* Kept alongside .bkw-fallback above (not replaced by it) for genuinely disabled JavaScript —
    scripting entirely off means the try/catch in the script below never runs at all, so this is
    the one path that doesn't depend on that script existing or executing correctly. The two
    overlapping in that narrow case is a harmless duplicate, not a broken or dead form. */}
<noscript>
  <div class="bkw-noscript">
    <p>{t['widget.noscript']}</p>
    {(contactEmail || contactPhone) && (
      <p class="bkw-noscript-contact">
        {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
        {contactEmail && contactPhone && ' · '}
        {contactPhone && <a href={`tel:${contactPhone}`}>{contactPhone}</a>}
      </p>
    )}
  </div>
</noscript>
</div>

<script>
  import 'cally';
  import { toMajorUnits } from '../../../../src/core/index';
  // This example reads the same exported wire types every consumer does — if a response shape
  // changes without this component following, it fails to compile here rather than at a
  // customer's browser.
  import type {
    ApiErrorEnvelope,
    AvailabilityDay,
    AvailabilityResponse,
    CatalogResponse,
    CatalogService,
    CheckoutResponse,
    QuoteResponse,
  } from '../../../../src/core/index';

  interface CalendarDateElement extends HTMLElement {
    value: string;
    focusedDate: string;
    isDateDisallowed: (date: Date) => boolean;
  }

  type Fallible<T> = Partial<T> & Partial<ApiErrorEnvelope>;
  interface WidgetData {
    locale: string;
    i18n: Record<string, string>;
  }

  function readData(form: HTMLFormElement): WidgetData {
    const island = form.querySelector<HTMLScriptElement>('[data-reserva-data]');
    return JSON.parse(island?.textContent ?? '{}') as WidgetData;
  }

  function fill(template: string, vars: Record<string, string | number>): string {
    return template.replace(/\{(\w+)\}/g, (match, name: string) => (name in vars ? String(vars[name]) : match));
  }

  function showError(form: HTMLFormElement, data: WidgetData, cause: unknown, fallbackKey: string): void {
    const error = form.querySelector<HTMLElement>('[data-reserva-error]');
    if (!error) return;
    const text = error.querySelector<HTMLElement>('[data-reserva-error-text]') ?? error;
    text.textContent = cause instanceof Error && cause.message ? cause.message : data.i18n[fallbackKey] ?? '';
    error.hidden = false;
  }

  function showRetry(form: HTMLFormElement): void {
    const retry = form.querySelector<HTMLElement>('[data-reserva-retry]');
    if (retry) retry.hidden = false;
  }

  function clearError(form: HTMLFormElement): void {
    const error = form.querySelector<HTMLElement>('[data-reserva-error]');
    if (error) error.hidden = true;
    const retry = form.querySelector<HTMLElement>('[data-reserva-retry]');
    if (retry) retry.hidden = true;
  }

  // The price shown is always the server-quoted price -- the widget carries no price table of its
  // own. Only the latest request may write to the DOM: quantity/pickup changes fire in quick
  // succession, and an older quote settling last must not overwrite a newer selection's price.
  const quoteState = new WeakMap<HTMLFormElement, number>();
  async function updatePrice(form: HTMLFormElement, data: WidgetData): Promise<void> {
    const target = form.querySelector<HTMLElement>('[data-reserva-price-value]');
    const endpoint = form.dataset.quoteEndpoint;
    if (!target || !endpoint) return;
    const formData = new FormData(form);
    const pickup = formData.get('pickupType');
    const generation = (quoteState.get(form) ?? 0) + 1;
    quoteState.set(form, generation);
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          serviceSlug: String(formData.get('serviceSlug') ?? ''),
          quantity: Number(formData.get('quantity')),
          ...(pickup === null ? {} : { pickup: String(pickup) }),
          locale: data.locale,
        }),
      });
      const result = await response.json() as Fallible<QuoteResponse>;
      if (quoteState.get(form) !== generation) return;
      // A quote the server won't give (an unsupported party size, say) blanks the price rather than
      // showing a stale one; the submit path surfaces the real error if the visitor books anyway.
      target.textContent = response.ok && result.priceMinor !== undefined && result.currency !== undefined
        ? new Intl.NumberFormat(data.locale, { style: 'currency', currency: result.currency }).format(toMajorUnits(result.priceMinor, result.currency))
        : '';
    } catch {
      if (quoteState.get(form) === generation) target.textContent = '';
    }
  }

  // The pickup and meeting-point groups are rendered from the deployment's catalog, so their ids,
  // labels, hints and usesMeetingPoint flags can't drift from what checkout accepts. A service
  // with no location module leaves both anchors empty: no pickupType field is submitted at all.
  function pickupBody(label: string, hint: string | null): HTMLSpanElement {
    const body = document.createElement('span');
    body.className = 'bkw-pickup-body';
    const labelSpan = document.createElement('span');
    labelSpan.className = 'bkw-pickup-label';
    labelSpan.textContent = label;
    body.append(labelSpan);
    if (hint !== null) {
      const hintSpan = document.createElement('span');
      hintSpan.className = 'bkw-pickup-hint';
      hintSpan.textContent = hint;
      body.append(hintSpan);
    }
    return body;
  }

  function radioGroup(legend: string, name: string, entries: Array<{ value: string; label: string; hint: string | null; usesMeetingPoint?: boolean }>): HTMLFieldSetElement {
    const fieldset = document.createElement('fieldset');
    fieldset.className = 'bkw-field';
    const caption = document.createElement('legend');
    caption.className = 'bkw-label';
    caption.textContent = legend;
    const list = document.createElement('div');
    list.className = 'bkw-pickups';
    for (const [index, entry] of entries.entries()) {
      const label = document.createElement('label');
      label.className = 'bkw-pickup';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = name;
      input.value = entry.value;
      input.required = true;
      if (index === 0) input.checked = true;
      if (entry.usesMeetingPoint !== undefined) input.dataset.usesMeetingPoint = String(entry.usesMeetingPoint);
      label.append(input, pickupBody(entry.label, entry.hint));
      list.append(label);
    }
    fieldset.append(caption, list);
    return fieldset;
  }

  function renderLocation(form: HTMLFormElement, service: CatalogService, data: WidgetData): void {
    const pickupSlot = form.querySelector<HTMLElement>('[data-reserva-pickup-slot]');
    const pointSlot = form.querySelector<HTMLElement>('[data-reserva-meeting-point-slot]');
    const pickupOptions = service.location?.pickupOptions ?? [];
    const meetingPoints = service.location?.meetingPoints ?? [];
    if (pickupSlot && pickupOptions.length === 1) {
      // A single option is not a choice: submit it as a hidden field, carrying the same flag the
      // radios do so syncMeetingPoints reads one thing in both shapes.
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'pickupType';
      hidden.value = pickupOptions[0]!.id;
      hidden.dataset.usesMeetingPoint = String(pickupOptions[0]!.usesMeetingPoint);
      pickupSlot.append(hidden);
    } else if (pickupSlot && pickupOptions.length > 1) {
      pickupSlot.append(radioGroup(data.i18n.pickup ?? '', 'pickupType', pickupOptions.map((option) => ({
        value: option.id,
        label: option.label,
        hint: option.hint,
        usesMeetingPoint: option.usesMeetingPoint,
      }))));
    }
    // 0-1 declared points render nothing — there is nothing for the visitor to choose, and the
    // server resolves the single point itself.
    if (pointSlot && meetingPoints.length >= 2) {
      const group = radioGroup(data.i18n.meetingPoint ?? '', 'meetingPointId', meetingPoints.map((point) => ({
        value: point.id,
        label: point.label,
        hint: null,
      })));
      group.dataset.reservaMeetingPoints = '';
      pointSlot.append(group);
    }
  }

  // Hides AND disables the meeting-point group when the selected pickup option doesn't use one --
  // disabling (not just hiding) is what drops its radios from FormData, so the submit handler
  // omits meetingPointId rather than sending it empty. No-op when the group isn't rendered at all.
  function syncMeetingPoints(form: HTMLFormElement): void {
    const wrap = form.querySelector<HTMLElement>('[data-reserva-meeting-points]');
    if (!wrap) return;
    const selected = form.querySelector<HTMLInputElement>('input[name="pickupType"]:checked')
      ?? form.querySelector<HTMLInputElement>('input[name="pickupType"]');
    const hide = selected?.dataset.usesMeetingPoint !== 'true';
    wrap.hidden = hide;
    for (const input of wrap.querySelectorAll<HTMLInputElement>('input[name="meetingPointId"]')) {
      input.disabled = hide;
    }
  }

  async function loadCatalog(form: HTMLFormElement, data: WidgetData): Promise<void> {
    const endpoint = form.dataset.catalogEndpoint;
    if (!endpoint) throw new Error('Booking form is missing its catalog endpoint');
    const response = await fetch(`${endpoint}?locale=${encodeURIComponent(data.locale)}`);
    const result = await response.json() as Fallible<CatalogResponse>;
    if (!response.ok || !result.services) throw new Error(result.error?.message ?? 'Catalog unavailable');
    const slug = String(new FormData(form).get('serviceSlug') ?? '');
    const service = result.services.find((entry) => entry.slug === slug);
    // A slug this deployment doesn't serve is an embedding mistake, not a runtime condition: fail
    // the init so the fallback (with its contact details) stays up instead of showing a form whose
    // every submission would 404.
    if (!service) throw new Error(`Service "${slug}" is not in this deployment's catalog`);
    renderLocation(form, service, data);
  }

  function dateKey(date: Date): string {
    return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
  }

  function calStatus(form: HTMLFormElement, text: string): void {
    const status = form.querySelector<HTMLElement>('[data-reserva-cal-status]');
    if (status) status.textContent = text;
  }

  function renderSlots(form: HTMLFormElement, day: AvailabilityDay | undefined, data: WidgetData): void {
    const wrap = form.querySelector<HTMLElement>('[data-reserva-slots-wrap]');
    const container = form.querySelector<HTMLElement>('[data-reserva-slots]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!wrap || !container) return;
    container.replaceChildren();
    const slots = day?.slots ?? [];
    wrap.hidden = false;
    // The button's initial label is a loading affordance (data-reserva-checkout only becomes
    // visible once this script runs); once availability actually resolves, restore its normal
    // label regardless of whether a slot ends up selectable.
    if (submit) submit.textContent = data.i18n.submit ?? submit.textContent;
    if (slots.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'bkw-empty';
      empty.textContent = data.i18n.noSlots ?? '';
      container.append(empty);
      if (submit) submit.disabled = true;
      return;
    }
    for (const [index, slot] of slots.entries()) {
      const label = document.createElement('label');
      label.className = 'bkw-slot';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'start';
      input.value = slot.start;
      input.required = true;
      if (index === 0) input.checked = true;
      const time = document.createElement('span');
      time.className = 'bkw-slot-time';
      time.textContent = slot.start.slice(11, 16);
      label.append(input, time);
      // The server gates the exact count against the deployment's own limitedThreshold, so a
      // non-null `remaining` IS the scarce case — the widget re-applies no threshold of its own.
      if (slot.remaining !== null) {
        const hint = document.createElement('span');
        hint.className = 'bkw-slot-hint';
        hint.textContent = fill(data.i18n.limited ?? '', { n: slot.remaining });
        label.append(hint);
      }
      container.append(label);
    }
    if (submit) submit.disabled = false;
  }

  // Per-form in-flight request state (keyed by the form element, since a page can host several
  // widget instances). The generation number is the actual correctness guard: an aborted fetch
  // can still settle before its abort takes effect, so every mutation re-checks it first.
  const requestState = new WeakMap<HTMLFormElement, { controller: AbortController; generation: number }>();

  // keepError leaves the current error message (e.g. a checkout failure the user still needs to
  // read) in place while the slot list refreshes underneath it.
  async function loadAvailability(form: HTMLFormElement, data: WidgetData, keepError = false): Promise<void> {
    const { availabilityEndpoint, availabilityFrom, availabilityTo } = form.dataset;
    const calendar = form.querySelector<CalendarDateElement>('[data-reserva-calendar]');
    if (!availabilityEndpoint || !availabilityFrom || !availabilityTo || !calendar) return;
    const formData = new FormData(form);
    const query = new URLSearchParams({
      service: String(formData.get('serviceSlug') ?? ''),
      quantity: String(formData.get('quantity') ?? ''),
      from: availabilityFrom,
      to: availabilityTo,
    });
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Fired from initial load, every party-size change, retry click, and post-checkout failure.
    // Aborting the previous request only saves work; the generation bump is the actual guard,
    // since an in-flight fetch can still resolve (or reject with something other than
    // AbortError) after abort.
    const previous = requestState.get(form);
    previous?.controller.abort();
    const controller = new AbortController();
    const generation = (previous?.generation ?? 0) + 1;
    requestState.set(form, { controller, generation });
    const isCurrent = (): boolean => requestState.get(form)?.generation === generation;

    calendar.setAttribute('aria-busy', 'true');
    calStatus(form, data.i18n.loadingSlots ?? '');
    if (!keepError) clearError(form);
    try {
      const response = await fetch(`${availabilityEndpoint}?${query}`, { cache: 'no-store', signal: controller.signal });
      const result = await response.json() as Fallible<AvailabilityResponse>;
      // Superseded by a newer party-size/retry request while this one was in flight — its result
      // is stale by definition (see the class comment above), so discard it without touching any
      // UI a newer, possibly-already-rendered request now owns.
      if (!isCurrent()) return;
      if (!response.ok || !result.days) throw new Error(result.error?.message ?? data.i18n.errorAvailability);
      const days = new Map(result.days.map((day) => [day.date, day]));
      // Reassigning the property re-renders the month grid, so sold-out/closed days grey out as
      // soon as availability (or the party size, which changes it) arrives.
      calendar.isDateDisallowed = (date) => (days.get(dateKey(date))?.slots.length ?? 0) === 0;
      const openDays = result.days.filter((day) => day.slots.length > 0);
      const current = days.get(calendar.value);
      const selected = current && current.slots.length > 0 ? current : openDays[0];
      if (selected) {
        calendar.value = selected.date;
        calendar.focusedDate = selected.date;
        calStatus(form, '');
        renderSlots(form, selected, data);
      } else {
        calendar.value = '';
        calStatus(form, data.i18n.noDates ?? '');
        renderSlots(form, undefined, data);
        if (submit) submit.disabled = true;
      }
      calendar.onchange = () => {
        clearError(form);
        renderSlots(form, days.get(calendar.value), data);
      };
    } catch (cause) {
      // Covers both a superseded request's real error and its own abort() above (AbortError) —
      // either way, a request that isn't current must never surface an error for what the visitor
      // is no longer looking at.
      if (!isCurrent()) return;
      calStatus(form, '');
      showError(form, data, cause, 'errorAvailability');
      showRetry(form);
      // The availability fetch itself failed, so renderSlots (which would otherwise restore the
      // idle label) never ran — do it here so the button doesn't read "loading" forever.
      if (submit) {
        submit.disabled = true;
        submit.textContent = data.i18n.submit ?? submit.textContent;
      }
    } finally {
      // A superseded request's finally must not clear aria-busy out from under the newer request
      // that's still in flight and already set it back to true for itself.
      if (isCurrent()) calendar.removeAttribute('aria-busy');
    }
  }

  async function initInstance(form: HTMLFormElement, fallback: HTMLElement | null): Promise<void> {
    // readData JSON.parses this instance's data island — a corrupted island throws here, caught
    // below, before any listener is attached or the form is revealed.
    const data = readData(form);
    // Awaited before any listener is bound: the pickup radios it renders are what those listeners
    // attach to, and a deployment that can't describe its own service can't take a booking.
    await loadCatalog(form, data);
    form.querySelector<HTMLSelectElement>('select[name="quantity"]')?.addEventListener('change', () => {
      void updatePrice(form, data);
      void loadAvailability(form, data);
    });
    for (const pickup of form.querySelectorAll<HTMLInputElement>('input[name="pickupType"]')) {
      pickup.addEventListener('change', () => {
        void updatePrice(form, data);
        syncMeetingPoints(form);
      });
    }
    form.querySelector<HTMLButtonElement>('[data-reserva-retry]')?.addEventListener('click', () => {
      void loadAvailability(form, data);
    });
    void updatePrice(form, data);
    syncMeetingPoints(form);
    void loadAvailability(form, data);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload: Record<string, unknown> = {
        serviceSlug: String(formData.get('serviceSlug') ?? ''),
        start: String(formData.get('start') ?? ''),
        quantity: Number(formData.get('quantity')),
        locale: String(formData.get('locale') ?? ''),
      };
      // A location-less service renders no pickupType field at all (see renderLocation above) —
      // omit it from the payload rather than sending an empty string, which checkout rejects as a
      // present-but-unsupported field.
      const pickupType = formData.get('pickupType');
      if (pickupType !== null) payload.pickupType = String(pickupType);
      // A disabled meeting-point group (pickupType 'custom', or no such group at all for a
      // single-point service) naturally drops out of FormData — follow that rather than sending
      // an empty string the server would reject as an unknown id.
      const meetingPointId = formData.get('meetingPointId');
      if (meetingPointId !== null) payload.meetingPointId = String(meetingPointId);
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const idleLabel = submit?.textContent ?? '';
      try {
        // data-endpoint is always rendered by the component; a missing value means hand-edited
        // markup, so surface an error instead of silently falling back to a URL that could 404.
        const endpoint = form.dataset.endpoint;
        if (!endpoint) throw new Error('Booking form is missing its endpoint');
        clearError(form);
        if (submit) {
          submit.disabled = true;
          submit.textContent = data.i18n.submitting ?? idleLabel;
        }
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json() as Fallible<CheckoutResponse>;
        if (!response.ok || !result.checkoutUrl) throw new Error(result.error?.message ?? data.i18n.errorCheckout);
        window.location.assign(result.checkoutUrl);
      } catch (cause) {
        if (submit) {
          submit.disabled = false;
          submit.textContent = idleLabel;
        }
        showError(form, data, cause, 'errorCheckout');
        // A checkout rejection usually means the slot list went stale (e.g. it just filled), so
        // reload the options rather than leaving the dead slot selectable — keeping the error on
        // screen, since the reload's own clearError would otherwise wipe it instantly.
        void loadAvailability(form, data, true);
      }
    });
    // Every step above succeeded: only now swap the always-visible fallback for the
    // now-functional form. Doing this earlier (e.g. before readData, as this used to) risks
    // revealing a form no listener ever got attached to.
    if (fallback) fallback.hidden = true;
    form.hidden = false;
  }

  for (const instance of document.querySelectorAll<HTMLElement>('[data-reserva-instance]')) {
    const form = instance.querySelector<HTMLFormElement>('[data-reserva-checkout]');
    if (!form) continue;
    // One broken instance must not stop its siblings from initializing (this is why the loop
    // doesn't await, and why each instance carries its own catch) — and this instance's fallback,
    // visible by default in markup, is left exactly as it started rather than revealing a dead form.
    void initInstance(form, instance.querySelector<HTMLElement>('[data-reserva-fallback]')).catch((cause: unknown) => {
      console.error('[reserva] widget instance failed to initialize; its fallback stays visible', cause);
    });
  }
</script>
