---
// Two BookingWidget instances on one page, proving per-instance ids
// (src/components/BookingWidget.astro) don't collide and each instance stays independently
// operable — not exercised by the homepage, which only ever renders one instance.
import BookingWidget from '../components/BookingWidget.astro';
import config from '../config';

const from = new Date().toISOString().slice(0, 10);
const to = new Date(Date.now() + 3 * 86_400_000).toISOString().slice(0, 10);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Two widgets</title>
  </head>
  <body>
    <section data-widget-index="0">
      <h1>Widget A</h1>
      <BookingWidget serviceSlug="oldTown" availabilityFrom={from} availabilityTo={to} locale={config.locales.default} />
    </section>
    <section data-widget-index="1">
      <h1>Widget B</h1>
      <BookingWidget serviceSlug="oldTown" availabilityFrom={from} availabilityTo={to} locale={config.locales.default} />
    </section>
  </body>
</html>
