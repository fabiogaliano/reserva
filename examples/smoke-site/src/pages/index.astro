---
import BookingWidget from '../../../../src/components/BookingWidget.astro';
import ManageBooking from '../../../../src/components/ManageBooking.astro';
import AdminDashboard from '../../../../src/components/AdminDashboard.astro';
import config from '../config';

const title = 'Bookkit local demo';
// The demo runtime is configured with timezone UTC, so UTC date keys match business dates.
const from = new Date().toISOString().slice(0, 10);
const to = new Date(Date.now() + 3 * 86_400_000).toISOString().slice(0, 10);
const availabilityUrl = `/api/booking/availability?tour=oldTown&people=2&from=${from}&to=${to}`;
// Plan 017 (design decision 5): the widget only needs {id, label} — the config's raw (unvalidated)
// meetingPoints array (see STOP condition 2) also carries mapsUrl, which the widget doesn't render.
const meetingPoints = config.tours.oldTown.meetingPoints?.map(({ id, label }) => ({ id, label })) ?? [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Cloudflare workerd + local D1</p>
        <h1>{title}</h1>
        <p>This demo uses simulated payment, calendar, email, operations, and analytics providers. No external service is contacted.</p>
      </header>

      <section>
        <h2>Create a booking</h2>
        <BookingWidget tourSlug="oldTown" availabilityFrom={from} availabilityTo={to} meetingPoints={meetingPoints} />
        <p>Submitting redirects through the confirmation route. The simulated payment provider reports the session as paid, which exercises confirmation and every provider seam.</p>
      </section>

      <section>
        <h2>Inspect the system</h2>
        <nav>
          <a href="/booking/admin">Open owner dashboard</a>
          <a href={availabilityUrl}>View availability JSON</a>
        </nav>
        <ol>
          <li>Create a booking above.</li>
          <li>Open the owner dashboard to see the D1 row and capacity controls.</li>
          <li>Use the booking's <strong>manage</strong> link in the dashboard to reschedule, cancel, refund, or mark no-show when eligible.</li>
          <li>Copy the customer management URL printed in the dev-server terminal to test the customer role and cutoff behavior.</li>
        </ol>
      </section>

      <section>
        <h2>Embeddable fragments</h2>
        <ManageBooking />
        <AdminDashboard />
      </section>

      <section>
        <h2>Local credentials</h2>
        <p>The admin bypass is enabled only in this demo runtime. The feed bearer token is <code>local-tourflow-secret</code>.</p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; background: #f3f5f7; color: #18212b; font: 16px/1.5 system-ui, sans-serif; }
  main { width: min(760px, calc(100% - 32px)); margin: 48px auto; display: grid; gap: 24px; }
  header, section { padding: 24px; border: 1px solid #d7dde3; border-radius: 14px; background: white; box-shadow: 0 8px 24px rgb(24 33 43 / 6%); }
  h1, h2 { margin-top: 0; }
  .eyebrow { margin: 0 0 8px; color: #52606d; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  nav { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
  a, button { border-radius: 8px; }
  a { display: inline-block; padding: 10px 14px; background: #1769e0; color: white; font-weight: 650; text-decoration: none; }
  code { padding: 2px 5px; border-radius: 4px; background: #edf1f5; }
</style>
