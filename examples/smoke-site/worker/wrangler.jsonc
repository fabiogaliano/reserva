{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Separate Worker for the scheduled reconciliation sweep — see scheduled.ts.
  "name": "reserva-smoke-scheduled",
  "compatibility_date": "2026-07-21",
  "main": "scheduled.ts",
  "d1_databases": [
    {
      "binding": "RESERVA_DB",
      "database_name": "reserva-smoke",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "RESERVA_TOKEN_ENC_KEY": "local-demo-token-encryption-key",
    "RESERVA_OPERATOR_SECRET": "local-operator-secret",
    "RESERVA_CSRF_SECRET": "local-demo-csrf-secret"
  },
  "triggers": {
    // Every 5 minutes, matching the retry backoff schedule's cadence closely enough.
    "crons": ["*/5 * * * *"]
  },
  // Full logging here since this is the only trace of reconciliation/incident/alert events.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
