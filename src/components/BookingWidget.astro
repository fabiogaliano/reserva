---
import routeConfig from 'virtual:bookkit/config';
import { resolvedPriceTableFor } from '../core/pricing';
import { defaultMessages, formatMessage, type BookkitMessages } from '../ui/messages';
import '../ui/components.css';

interface StartOption {
  value: string;
  label: string;
}

interface PricingRuleProp {
  maxPeople: number;
  pickup: 'default' | 'custom';
  priceCents: number;
}

interface Props {
  tourSlug: string;
  checkoutEndpoint?: string;
  availabilityEndpoint?: string;
  availabilityFrom?: string;
  availabilityTo?: string;
  locale?: string;
  peopleOptions?: number[];
  pickupTypes?: Array<'default' | 'custom'>;
  // Plan 017 (design decision 5): labels are config-provided plain strings, like
  // meetingPoint.label today — pass config.tours[slug].meetingPoints mapped to {id, label}. 0 or 1
  // entries render nothing new (single-point tours stay byte-identical); 2+ renders a radio group.
  meetingPoints?: Array<{ id: string; label: string }>;
  startOptions?: StartOption[];
  // Pass the tour's pricing rules (config.tours[slug].pricing) to show a live price; omit to hide.
  pricing?: PricingRuleProp[];
  currency?: string;
  // Used when availability is static: fetched availability supplies the server-configured value,
  // while this fallback preserves scarcity hints for startOptions-only consumers.
  limitedThreshold?: number;
  // Shown in the <noscript> fallback as a way to book without JavaScript — pass
  // config.business.contact.email / .phone. Either, both, or neither may be supplied.
  contactEmail?: string;
  contactPhone?: string;
  // Partial overrides merged over the shipped English catalog — feed the page's locale copy here.
  messages?: Partial<BookkitMessages>;
  showTitle?: boolean;
}

const {
  tourSlug,
  checkoutEndpoint = routeConfig.paths.checkout,
  availabilityEndpoint = routeConfig.paths.availability,
  availabilityFrom,
  availabilityTo,
  locale = 'en',
  peopleOptions = [1, 2, 3, 4],
  pickupTypes = ['default', 'custom'],
  meetingPoints = [],
  startOptions = [],
  pricing,
  currency = 'EUR',
  limitedThreshold = 3,
  contactEmail,
  contactPhone,
  messages: messageOverrides = {},
  showTitle = true,
} = Astro.props;

const t: BookkitMessages = { ...defaultMessages, ...messageOverrides };
const usesAvailability = availabilityFrom !== undefined && availabilityTo !== undefined;
const peopleLabel = (n: number): string => formatMessage(n === 1 ? t['widget.person'] : t['widget.peopleCount'], { n });
const resolvedPrices = pricing ? resolvedPriceTableFor({ pricing }) : null;

// Everything the client script needs that can vary per render (copy, pricing, locale) travels in
// a JSON data island rather than an inline define:vars script, so no unhashed inline JS is ever
// emitted and strict script-src CSPs keep working.
const scriptData = {
  locale,
  currency,
  resolvedPrices,
  limitedThreshold,
  i18n: {
    loadingSlots: t['widget.loadingSlots'],
    noSlots: t['widget.noSlots'],
    noDates: t['widget.noDates'],
    closed: t['widget.closed'],
    soldOut: t['widget.soldOut'],
    limited: t['widget.limited'],
    spotsLeft: t['widget.spotsLeft'],
    submit: t['widget.submit'],
    submitting: t['widget.submitting'],
    errorAvailability: t['widget.errorAvailability'],
    errorCheckout: t['widget.errorCheckout'],
  },
};

const pickupCopy: Record<'default' | 'custom', { label: string; hint: string }> = {
  default: { label: t['widget.pickupDefault'], hint: t['widget.pickupDefaultHint'] },
  custom: { label: t['widget.pickupCustom'], hint: t['widget.pickupCustomHint'] },
};

// A full UUID (not a truncated slice or a module-scope counter, which would collide across
// concurrent renders) so two instances of this component on the same page never share an id —
// see plan 014 item A.
const dateLabelId = `bkw-date-label-${crypto.randomUUID()}`;
---

{/* Wraps this instance's form together with its fallback so the script (which may run once for
    several instances on one page — see below) can pair each form with its own fallback rather
    than a global lookup, and so one broken instance's fallback can never be confused for a
    sibling's. */}
<div class="bkw-instance" data-bookkit-instance>
<form
  class="bk-widget"
  data-bookkit-checkout
  data-endpoint={checkoutEndpoint}
  data-availability-endpoint={usesAvailability ? availabilityEndpoint : undefined}
  data-availability-from={availabilityFrom}
  data-availability-to={availabilityTo}
  aria-label={t['widget.title']}
  hidden
>
  <script type="application/json" data-bookkit-data set:html={JSON.stringify(scriptData).replace(/</g, '\\u003c')} />
  <input type="hidden" name="tourSlug" value={tourSlug} />
  <input type="hidden" name="locale" value={locale} />

  {showTitle && <h2 class="bkw-title">{t['widget.title']}</h2>}

  <label class="bkw-field">
    <span class="bkw-label">{t['widget.people']}</span>
    <select class="bkw-select" name="people" required>
      {peopleOptions.map((people) => <option value={people}>{peopleLabel(people)}</option>)}
    </select>
  </label>

  {usesAvailability ? (
    <>
      <div class="bkw-field">
        <span class="bkw-label" id={dateLabelId}>{t['widget.date']}</span>
        <calendar-date
          class="bkw-cal"
          min={availabilityFrom}
          max={availabilityTo}
          locale={locale}
          aria-labelledby={dateLabelId}
          data-bookkit-calendar
        >
          <svg aria-hidden="true" slot="previous" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
          <svg aria-hidden="true" slot="next" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          <calendar-month></calendar-month>
        </calendar-date>
        <p class="bkw-cal-status" data-bookkit-cal-status role="status">{t['widget.loadingSlots']}</p>
      </div>
      <fieldset class="bkw-field bkw-slots-field" data-bookkit-slots-wrap hidden>
        <legend class="bkw-label">{t['widget.time']}</legend>
        <div class="bkw-slots" data-bookkit-slots role="radiogroup" aria-label={t['widget.time']}></div>
      </fieldset>
    </>
  ) : startOptions.length > 0 ? (
    <label class="bkw-field">
      <span class="bkw-label">{t['widget.start']}</span>
      <select class="bkw-select" name="start" required>
        {startOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
  ) : (
    <label class="bkw-field">
      <span class="bkw-label">{t['widget.start']}</span>
      <input class="bkw-input" name="start" type="text" placeholder="2026-08-01T10:00:00+01:00" required />
    </label>
  )}

  {pickupTypes.length === 1 ? (
    <input type="hidden" name="pickupType" value={pickupTypes[0]} />
  ) : (
    <fieldset class="bkw-field">
      <legend class="bkw-label">{t['widget.pickup']}</legend>
      <div class="bkw-pickups">
        {pickupTypes.map((pickupType, index) => (
          <label class="bkw-pickup">
            <input type="radio" name="pickupType" value={pickupType} required checked={index === 0} />
            <span class="bkw-pickup-body">
              <span class="bkw-pickup-label">{pickupCopy[pickupType].label}</span>
              <span class="bkw-pickup-hint">{pickupCopy[pickupType].hint}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  {/* Plan 017 (design decision 5): 0-1 points render nothing new — a single-point tour's markup
      stays byte-identical to before this prop existed. 2+ mirrors the pickupType group above
      (same fieldset/legend/bkw-pickup markup and classes). Hidden/disabled client-side while
      pickupType is 'custom' (see the script below); the server's requirement rule is
      authoritative regardless of what this toggle does. */}
  {meetingPoints.length >= 2 && (
    <fieldset class="bkw-field" data-bookkit-meeting-points>
      <legend class="bkw-label">{t['widget.meetingPoint']}</legend>
      <div class="bkw-pickups">
        {meetingPoints.map((point, index) => (
          <label class="bkw-pickup">
            <input type="radio" name="meetingPointId" value={point.id} required checked={index === 0} />
            <span class="bkw-pickup-body">
              <span class="bkw-pickup-label">{point.label}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  {pricing && (
    <p class="bkw-price" data-bookkit-price aria-live="polite">
      <span class="bkw-price-label">{t['common.price']}</span>
      <strong class="bkw-price-value" data-bookkit-price-value></strong>
      <span class="bkw-price-note">{t['widget.priceNote']}</span>
    </p>
  )}

  {/* In availability mode the button stays disabled until slots render, so a fast click can never
      post an empty start; its label shows the loading state until renderSlots restores the normal
      submit label and re-enables it. */}
  <button type="submit" class="bkw-submit" disabled={usesAvailability}>{usesAvailability ? t['widget.loadingSlots'] : t['widget.submit']}</button>
  <p class="bkw-error" data-bookkit-error role="alert" hidden>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
    <span data-bookkit-error-text></span>
  </p>
  <button type="button" class="bkw-retry" data-bookkit-retry hidden>{t['widget.retry']}</button>
</form>

{/* Visible by default — not `hidden` — because a hidden fallback cannot help when the widget
    module's request is blocked or its synchronous init throws before the script below ever
    reaches the point where it hides this and reveals the form (see that script: only a fully
    successful init does so). A visitor briefly seeing this before a healthy widget finishes
    initializing is the intended progressive-enhancement baseline, not a bug. */}
<div class="bkw-fallback" data-bookkit-fallback>
  <p>{t['widget.noscript']}</p>
  {(contactEmail || contactPhone) && (
    <p class="bkw-noscript-contact">
      {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
      {contactEmail && contactPhone && ' · '}
      {contactPhone && <a href={`tel:${contactPhone}`}>{contactPhone}</a>}
    </p>
  )}
</div>

{/* Kept alongside .bkw-fallback above (not replaced by it) for genuinely disabled JavaScript —
    scripting entirely off means the try/catch in the script below never runs at all, so this is
    the one path that doesn't depend on that script existing or executing correctly. The two
    overlapping in that narrow case is a harmless duplicate, not a broken or dead form. */}
<noscript>
  <div class="bkw-noscript">
    <p>{t['widget.noscript']}</p>
    {(contactEmail || contactPhone) && (
      <p class="bkw-noscript-contact">
        {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
        {contactEmail && contactPhone && ' · '}
        {contactPhone && <a href={`tel:${contactPhone}`}>{contactPhone}</a>}
      </p>
    )}
  </div>
</noscript>
</div>

<script>
  import 'cally';

  interface CalendarDateElement extends HTMLElement {
    value: string;
    focusedDate: string;
    isDateDisallowed: (date: Date) => boolean;
  }

  interface AvailabilitySlot { start: string; remaining: number; remainingBookings: number }
  interface AvailabilityDay { date: string; status: string; closedReason?: string; slots: AvailabilitySlot[] }
  interface AvailabilityResponse { days?: AvailabilityDay[]; limitedThreshold?: number; error?: { message?: string } }
  interface ResolvedPriceTable {
    default: number[];
    custom: number[];
  }
  interface WidgetData {
    locale: string;
    currency: string;
    resolvedPrices: ResolvedPriceTable | null;
    limitedThreshold: number;
    i18n: Record<string, string>;
  }

  function readData(form: HTMLFormElement): WidgetData {
    const island = form.querySelector<HTMLScriptElement>('[data-bookkit-data]');
    return JSON.parse(island?.textContent ?? '{}') as WidgetData;
  }

  function fill(template: string, vars: Record<string, string | number>): string {
    return template.replace(/\{(\w+)\}/g, (match, name: string) => (name in vars ? String(vars[name]) : match));
  }

  function showError(form: HTMLFormElement, data: WidgetData, cause: unknown, fallbackKey: string): void {
    const error = form.querySelector<HTMLElement>('[data-bookkit-error]');
    if (!error) return;
    const text = error.querySelector<HTMLElement>('[data-bookkit-error-text]') ?? error;
    text.textContent = cause instanceof Error && cause.message ? cause.message : data.i18n[fallbackKey] ?? '';
    error.hidden = false;
  }

  function showRetry(form: HTMLFormElement): void {
    const retry = form.querySelector<HTMLElement>('[data-bookkit-retry]');
    if (retry) retry.hidden = false;
  }

  function clearError(form: HTMLFormElement): void {
    const error = form.querySelector<HTMLElement>('[data-bookkit-error]');
    if (error) error.hidden = true;
    const retry = form.querySelector<HTMLElement>('[data-bookkit-retry]');
    if (retry) retry.hidden = true;
  }

  function updatePrice(form: HTMLFormElement, data: WidgetData): void {
    const target = form.querySelector<HTMLElement>('[data-bookkit-price-value]');
    if (!target || !data.resolvedPrices) return;
    const people = Number(new FormData(form).get('people'));
    const pickup = new FormData(form).get('pickupType') === 'custom' ? 'custom' : 'default';
    const priceCents = data.resolvedPrices[pickup][people];
    target.textContent = priceCents === undefined
      ? ''
      : new Intl.NumberFormat(data.locale, { style: 'currency', currency: data.currency }).format(priceCents / 100);
  }

  // Plan 017 (design decision 5): hides AND disables the meeting-point group while pickupType is
  // 'custom' — disabling (not just hiding) is what actually drops its radios from FormData, which
  // is what the submit handler below relies on to omit meetingPointId rather than send it empty.
  // No-ops when the group isn't in the markup at all (0-1 declared points).
  function syncMeetingPoints(form: HTMLFormElement): void {
    const wrap = form.querySelector<HTMLElement>('[data-bookkit-meeting-points]');
    if (!wrap) return;
    const isCustom = new FormData(form).get('pickupType') === 'custom';
    wrap.hidden = isCustom;
    for (const input of wrap.querySelectorAll<HTMLInputElement>('input[name="meetingPointId"]')) {
      input.disabled = isCustom;
    }
  }

  function dateKey(date: Date): string {
    return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
  }

  function calStatus(form: HTMLFormElement, text: string): void {
    const status = form.querySelector<HTMLElement>('[data-bookkit-cal-status]');
    if (status) status.textContent = text;
  }

  function renderSlots(form: HTMLFormElement, day: AvailabilityDay | undefined, data: WidgetData): void {
    const wrap = form.querySelector<HTMLElement>('[data-bookkit-slots-wrap]');
    const container = form.querySelector<HTMLElement>('[data-bookkit-slots]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!wrap || !container) return;
    container.replaceChildren();
    const slots = day?.slots ?? [];
    wrap.hidden = false;
    // The button's initial label is a loading affordance (data-bookkit-checkout only becomes
    // visible once this script runs); once availability actually resolves, restore its normal
    // label regardless of whether a slot ends up selectable.
    if (submit) submit.textContent = data.i18n.submit ?? submit.textContent;
    if (slots.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'bkw-empty';
      empty.textContent = data.i18n.noSlots ?? '';
      container.append(empty);
      if (submit) submit.disabled = true;
      return;
    }
    for (const [index, slot] of slots.entries()) {
      const label = document.createElement('label');
      label.className = 'bkw-slot';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'start';
      input.value = slot.start;
      input.required = true;
      if (index === 0) input.checked = true;
      const time = document.createElement('span');
      time.className = 'bkw-slot-time';
      time.textContent = slot.start.slice(11, 16);
      label.append(input, time);
      if (slot.remainingBookings > 0 && slot.remainingBookings <= data.limitedThreshold) {
        const hint = document.createElement('span');
        hint.className = 'bkw-slot-hint';
        hint.textContent = fill(data.i18n.limited ?? '', { n: slot.remainingBookings });
        label.append(hint);
      }
      container.append(label);
    }
    if (submit) submit.disabled = false;
  }

  // Per-form in-flight request state (keyed by the form element, not module-scope, since a page
  // can host several widget instances — see the instance loop below). Each entry pairs the
  // AbortController that cancels the previous request with a monotonically increasing generation
  // number, which is the actual correctness guard (see loadAvailability): aborting only saves
  // work, since an aborted fetch can still settle before its abort takes effect.
  const requestState = new WeakMap<HTMLFormElement, { controller: AbortController; generation: number }>();

  // keepError leaves the current error message (e.g. a checkout failure the user still needs to
  // read) in place while the slot list refreshes underneath it.
  async function loadAvailability(form: HTMLFormElement, data: WidgetData, keepError = false): Promise<void> {
    const { availabilityEndpoint, availabilityFrom, availabilityTo } = form.dataset;
    const calendar = form.querySelector<CalendarDateElement>('[data-bookkit-calendar]');
    if (!availabilityEndpoint || !availabilityFrom || !availabilityTo || !calendar) return;
    const formData = new FormData(form);
    const query = new URLSearchParams({
      tour: String(formData.get('tourSlug') ?? ''),
      people: String(formData.get('people') ?? ''),
      from: availabilityFrom,
      to: availabilityTo,
    });
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Fired from initial load, every party-size change, retry click, and post-checkout failure —
    // an older request settling after a newer one must never win. Abort it (saves the network/
    // parse work) and bump the generation (the actual guard: every UI mutation below re-checks
    // this before touching shared form state, since an in-flight fetch can still resolve, or
    // reject with something other than AbortError, before the abort takes effect).
    const previous = requestState.get(form);
    previous?.controller.abort();
    const controller = new AbortController();
    const generation = (previous?.generation ?? 0) + 1;
    requestState.set(form, { controller, generation });
    const isCurrent = (): boolean => requestState.get(form)?.generation === generation;

    calendar.setAttribute('aria-busy', 'true');
    calStatus(form, data.i18n.loadingSlots ?? '');
    if (!keepError) clearError(form);
    try {
      const response = await fetch(`${availabilityEndpoint}?${query}`, { cache: 'no-store', signal: controller.signal });
      const result = await response.json() as AvailabilityResponse;
      // Superseded by a newer party-size/retry request while this one was in flight — its result
      // is stale by definition (see the class comment above), so discard it without touching any
      // UI a newer, possibly-already-rendered request now owns.
      if (!isCurrent()) return;
      if (!response.ok || !result.days) throw new Error(result.error?.message ?? data.i18n.errorAvailability);
      // Availability is server-configured, so its threshold takes precedence over this render's
      // fallback prop and keeps slot hints aligned with the day statuses in this same response.
      const limitedThreshold = result.limitedThreshold;
      if (typeof limitedThreshold === 'number' && Number.isInteger(limitedThreshold) && limitedThreshold >= 0) {
        data.limitedThreshold = limitedThreshold;
      }
      const days = new Map(result.days.map((day) => [day.date, day]));
      // Reassigning the property re-renders the month grid, so sold-out/closed days grey out as
      // soon as availability (or the party size, which changes it) arrives.
      calendar.isDateDisallowed = (date) => (days.get(dateKey(date))?.slots.length ?? 0) === 0;
      const openDays = result.days.filter((day) => day.slots.length > 0);
      const current = days.get(calendar.value);
      const selected = current && current.slots.length > 0 ? current : openDays[0];
      if (selected) {
        calendar.value = selected.date;
        calendar.focusedDate = selected.date;
        calStatus(form, '');
        renderSlots(form, selected, data);
      } else {
        calendar.value = '';
        calStatus(form, data.i18n.noDates ?? '');
        renderSlots(form, undefined, data);
        if (submit) submit.disabled = true;
      }
      calendar.onchange = () => {
        clearError(form);
        renderSlots(form, days.get(calendar.value), data);
      };
    } catch (cause) {
      // Covers both a superseded request's real error and its own abort() above (AbortError) —
      // either way, a request that isn't current must never surface an error for what the visitor
      // is no longer looking at.
      if (!isCurrent()) return;
      calStatus(form, '');
      showError(form, data, cause, 'errorAvailability');
      showRetry(form);
      // The availability fetch itself failed, so renderSlots (which would otherwise restore the
      // idle label) never ran — do it here so the button doesn't read "loading" forever.
      if (submit) {
        submit.disabled = true;
        submit.textContent = data.i18n.submit ?? submit.textContent;
      }
    } finally {
      // A superseded request's finally must not clear aria-busy out from under the newer request
      // that's still in flight and already set it back to true for itself.
      if (isCurrent()) calendar.removeAttribute('aria-busy');
    }
  }

  for (const instance of document.querySelectorAll<HTMLElement>('[data-bookkit-instance]')) {
    const form = instance.querySelector<HTMLFormElement>('[data-bookkit-checkout]');
    const fallback = instance.querySelector<HTMLElement>('[data-bookkit-fallback]');
    if (!form) continue;
    try {
      // readData JSON.parses this instance's data island — a corrupted island throws here, caught
      // below, before any listener is attached or the form is revealed.
      const data = readData(form);
      form.querySelector<HTMLSelectElement>('select[name="people"]')?.addEventListener('change', () => {
        updatePrice(form, data);
        void loadAvailability(form, data);
      });
      for (const pickup of form.querySelectorAll<HTMLInputElement>('input[name="pickupType"]')) {
        pickup.addEventListener('change', () => {
          updatePrice(form, data);
          syncMeetingPoints(form);
        });
      }
      form.querySelector<HTMLButtonElement>('[data-bookkit-retry]')?.addEventListener('click', () => {
        void loadAvailability(form, data);
      });
      updatePrice(form, data);
      syncMeetingPoints(form);
      void loadAvailability(form, data);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const payload: Record<string, unknown> = {
          tourSlug: String(formData.get('tourSlug') ?? ''),
          start: String(formData.get('start') ?? ''),
          people: Number(formData.get('people')),
          pickupType: String(formData.get('pickupType') ?? ''),
          locale: String(formData.get('locale') ?? ''),
        };
        // Plan 017 (design decision 5): a disabled meeting-point group (pickupType 'custom', or no
        // such group at all for a single-point tour) naturally drops out of FormData — follow that
        // rather than sending an empty string the server would reject as an unknown id.
        const meetingPointId = formData.get('meetingPointId');
        if (meetingPointId !== null) payload.meetingPointId = String(meetingPointId);
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const idleLabel = submit?.textContent ?? '';
        try {
          // data-endpoint is always rendered by the component (checkoutEndpoint always has a
          // resolved default), so a missing value here means the markup was hand-edited or the
          // form is missing its wrapper — either way, falling back to an unprefixed literal would
          // silently 404 under a routePrefix, so surface the error instead of guessing a URL.
          const endpoint = form.dataset.endpoint;
          if (!endpoint) throw new Error('Booking form is missing its endpoint');
          clearError(form);
          if (submit) {
            submit.disabled = true;
            submit.textContent = data.i18n.submitting ?? idleLabel;
          }
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json() as { checkoutUrl?: string; error?: { message?: string } };
          if (!response.ok || !result.checkoutUrl) throw new Error(result.error?.message ?? data.i18n.errorCheckout);
          window.location.assign(result.checkoutUrl);
        } catch (cause) {
          if (submit) {
            submit.disabled = false;
            submit.textContent = idleLabel;
          }
          showError(form, data, cause, 'errorCheckout');
          // A checkout rejection usually means the slot list went stale (e.g. it just filled), so
          // reload the options rather than leaving the dead slot selectable — keeping the error on
          // screen, since the reload's own clearError would otherwise wipe it instantly.
          void loadAvailability(form, data, true);
        }
      });
      // Every synchronous step above succeeded: only now swap the always-visible fallback for the
      // now-functional form. Doing this earlier (e.g. before readData, as this used to) risks
      // revealing a form no listener ever got attached to.
      if (fallback) fallback.hidden = true;
      form.hidden = false;
    } catch (cause) {
      // One broken instance must not stop its siblings from initializing (this is why the loop
      // above doesn't hoist a single top-level try/catch) — and this instance's fallback, visible
      // by default in markup, is left exactly as it started rather than revealing a dead form.
      console.error('[bookkit] widget instance failed to initialize; its fallback stays visible', cause);
    }
  }
</script>
