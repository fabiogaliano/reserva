---
import routeConfig from 'virtual:bookkit/config';
import { defaultLocale, resolveMessages, type BookkitMessages } from '../ui/messages';
import '../ui/components.css';

interface Props {
  token?: string;
  endpoint?: string;
  locale?: string;
  messages?: Partial<BookkitMessages>;
}

const { token = '', endpoint = routeConfig.paths.managePage, locale = defaultLocale, messages: messageOverrides = {} } = Astro.props;
const t: BookkitMessages = { ...resolveMessages(undefined, locale), ...messageOverrides };
// A full UUID per render so two instances of this component on the same page never share an id —
// see plan 014 item A.
const titleId = `bookkit-manage-title-${crypto.randomUUID()}`;
---

<section class="bk-embed" aria-labelledby={titleId}>
  <h2 id={titleId} class="bke-title">{t['manage.entryTitle']}</h2>
  <p class="bke-hint">{t['manage.entryHint']}</p>
  <form method="get" action={endpoint}>
    <label class="bke-field">
      <span class="bke-label">{t['manage.entryToken']}</span>
      <input class="bke-input" name="token" value={token} autocomplete="off" required />
    </label>
    <button type="submit" class="bke-submit">{t['manage.entryOpen']}</button>
  </form>
</section>
