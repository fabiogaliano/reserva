{
  // Same publish build as the main package, from this package's own src/. `@reservajs/astro/*`
  // stays an external specifier in the emitted JS and declarations — it is a peer, resolved in the
  // consumer's install.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowImportingTsExtensions": false,
    // The adapter builds after the root package has emitted dist/. Resolve against that artifact,
    // so this does not depend on a package-manager-specific workspace peer link.
    "paths": {
      "@reservajs/astro": ["../../dist/index.d.ts"],
      "@reservajs/astro/core": ["../../dist/core/index.d.ts"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"]
}
