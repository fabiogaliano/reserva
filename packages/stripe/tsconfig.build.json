{
  // Same publish build as the main package, from this package's own src/. `@reservajs/astro/*`
  // stays an external specifier in the emitted JS and declarations — it is a peer, resolved in the
  // consumer's install.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowImportingTsExtensions": false,
    // Reset the repo-level source aliases: the publish build must typecheck against the peer's
    // published declarations (node_modules/@reservajs/astro/dist), exactly as a consumer's build
    // does, not against this repository's sources.
    "paths": {},
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"]
}
